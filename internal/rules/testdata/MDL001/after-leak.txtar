# After a leak origin (P1) the comment becomes "#", not an empty line.
-- options --
mydumper-version: v0.19.3-3
select: MDL001, MDL402
-- input.cnf --
[mydumper]
# see [docs]
# mydumper-lint: disable-next-line=MDL402

routines=1
-- diagnostics --
3:36-3:42 info MDL001[unused-suppression] unused suppression: MDL402 reported nothing here
  fix (safe): Remove the suppression comment
-- fixed.cnf --
[mydumper]
# see [docs]
#

routines=1
