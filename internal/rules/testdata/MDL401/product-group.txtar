# mydumper reads its per-product option groups from v0.21.2-2 (F16), with
# the same GOption context as [mydumper]: an unknown option is fatal until
# v1.0.1-1.
-- options --
mydumper-version: v0.21.3-1
-- input.cnf --
[mydumper_mysql]
bogus=1
-- diagnostics --
2:1-2:6 error MDL401[unknown-option] `bogus` is not a mydumper option in v0.21.3-1
  = mydumper aborts at startup: "option parsing failed: Unknown option --bogus, try --help". [mydumper_mysql] is only read when the server matches it.
