# Harmless only because the regex line leaves equal_found set.
-- input.cnf.esc --
[mydumper]\nregex=^(a[bc])\n  \nthreads=4\n
-- fixed.cnf --
[mydumper]
regex=^(a[bc])

threads=4
-- diagnostics --
3:1-3:3 error MDL102[whitespace-only-line] line contains only whitespace: harmless here only because the line above keeps mydumper's pre-processor from appending `= 1` to it
  = Any change to the line above can make mydumper ignore the entire file.
  fix (safe): Remove the whitespace
