Control of MDL603 (F14): an extra file with neither [mydumper] nor [client]
does not take over, so the defaults file's [client] still provides the
connection; the extra file's table section is merged, so users.email is
masked.
-- scenario --
tool: mydumper
versions: >= v0.19.1-1
args: --defaults-file /work/defaults.cnf --defaults-extra-file /work/extra.cnf --database app
lint: MDL405
expect config-loaded: true
expect exit: 0
expect connected: true
expect column app.users.email: masked
when kb:table-sections-ignored
# F17: this mydumper loses every table section (MDL511).
lint: MDL405, MDL511
expect column app.users.email: plaintext
end
-- defaults.cnf --
[client]
host=mysql
user=e2e
password=e2e-password
-- extra.cnf --
[`app`.`users`]
`email`=random_string
-- .mydumper-lint.yaml --
load-sets:
  - defaults-file: defaults.cnf
    extra-files: [extra.cnf]
