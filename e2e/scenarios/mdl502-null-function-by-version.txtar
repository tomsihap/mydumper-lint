MDL502, F10: the "null" masking function only exists in some versions (the
knowledge base: from v0.21.4-1). Where it exists, users.email is dumped as
NULL; elsewhere "null" is an unknown function, so the column falls back to
identity (F10): plaintext up to v0.21.2-4, empty in v0.21.3-1 and v0.21.3-2.
The kb block checks the knowledge base for every version; the version blocks
check the boundaries.
-- scenario --
tool: mydumper
versions: >= v0.19.1-1
args: --defaults-file /work/mydumper.cnf --host mysql --user e2e --password e2e-password --database app
lint:
expect config-loaded: true
expect exit: 0

when kb:masquerade=null
expect column app.users.email: null
end

when kb:!masquerade=null, kb:!table-sections-ignored
lint: MDL502
end

when >= v0.21.4-1
expect column app.users.email: null
end

when < v0.21.3-1
expect column app.users.email: plaintext
end

when >= v0.21.3-1, < v0.21.4-1
expect column app.users.email: empty
end

when kb:table-sections-ignored
# F17: this mydumper loses every table section (MDL511); null does not exist yet.
lint: MDL502, MDL511
end
-- mydumper.cnf --
[mydumper]
threads=2

[`app`.`users`]
`email`=null
