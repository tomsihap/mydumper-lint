# Build and test outputs
/bin/
/dist/
/coverage.out
/coverage.html
*.test
*.prof

# Local oracle build
/tools/oracle/oracle
/tools/oracle/*.o

# Caches
/.cache/
/e2e/.out/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Playground build output (make playground)
/web/playground/mydumper-lint.wasm
/web/playground/wasm_exec.js

# VS Code extension (make vscode)
/editors/vscode/node_modules/
/editors/vscode/*.vsix
# Filled while packaging (scripts/package-release.sh, make vscode-host)
/editors/vscode/bin/
/editors/vscode/dist/
/editors/vscode/CHANGELOG.md
# VS Code downloaded by the extension's tests (make vscode-test)
/editors/vscode/.vscode-test/
