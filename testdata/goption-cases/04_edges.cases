strict true
option n - int -
arg g
arg --n
arg 0XaB

case e:int-06
strict true
option n - int -
arg g
arg --n
arg 0x7fffffff

case e:int-07
strict true
option n - int -
arg g
arg --n
arg 0x80000000

case e:int-08
strict true
option n - int -
arg g
arg --n
arg 0xg

case e:int-09
strict true
option n - int -
arg g
