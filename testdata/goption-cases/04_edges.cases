case e:separator-then-dash
# a leftover after -- that starts with '-' keeps the separator
strict false
option threads t int -
option routines R none -
arg g
arg --threads
arg 4
arg --
arg -x
arg y

case e:separator-then-plain
strict false
option threads t int -
option routines R none -
arg g
arg --threads
arg 4
arg --
arg y

case e:separator-at-end
strict false
option threads t int -
option routines R none -
arg g
arg --routines
arg --

case e:separator-after-unknown-short
# lenient: an unknown short option keeps the separator
strict false
option threads t int -
option routines R none -
arg g
arg -z
arg --
arg y

case e:separator-twice
strict false
option threads t int -
option routines R none -
arg g
arg --
arg --
arg y

case e:dash-alone
strict false
option threads t int -
option routines R none -
arg g
arg -
arg --routines

case e:callback-no-arg
strict true
option cb - callback no_arg
option routines R none -
arg g
arg --cb
arg v
arg --routines

case e:callback-no-arg-inline
strict true
option cb - callback no_arg
arg g
arg --cb=v

case e:alias-empty-prefix
strict true
option threads t int -
group daemongroup
option snapshot-count X int -
arg g
arg ---snapshot-count
arg 3

case e:alias-prefix
strict true
option threads t int -
group daemongroup
option snapshot-count X int -
arg g
arg --dae-snapshot-count
arg 3
