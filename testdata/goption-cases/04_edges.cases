# Edges of GOption's argument parsing and of strtol/strtod that unit tests
# alone cannot settle: integer bounds, hexadecimal case, double exponents,
# subnormals and nan(...), the "--" separator, callbacks without argument,
# and the group alias prefix. Expected output recorded with the oracle.

case e:int-00
strict true
option n - int -
arg g
arg --n
arg 2147483647

case e:int-01
strict true
option n - int -
arg g
arg --n
arg -2147483648

case e:int-02
strict true
option n - int -
arg g
arg --n
arg 2147483648

case e:int-03
strict true
option n - int -
arg g
arg --n
arg -2147483649

